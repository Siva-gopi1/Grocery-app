{
  "builds": [
    {
      "src": "backend/server.py",
      "use": "@vercel/python"
    },
    {
      "src": "ui/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "backend/server.py" },
    { "src": "/(.*\\.(html|css|js|jpg|jpeg|png|gif|svg|ico))", "dest": "ui/$1" },
    { "src": "/", "dest": "ui/index.html" }
  ]
}
